# Copy to .env.local and fill in. Never commit real keys.

# Jev, the pilot: a Vercel AI Gateway key. Four answers a second needs the gateway's paid tier.
AI_GATEWAY_API_KEY=
# The coach: a Nebius Token Factory key, for NVIDIA Nemotron.
NEBIUS_API_KEY=

# jev (the default), or fake to fly with an offline stand-in whose moves are labeled SIMULATED.
SYSTEM1=jev

# The models. These are the defaults; change them only to try another model.
JEV_MODEL=typesafe-ai/jev
COACH_MODEL=nvidia/Nemotron-3_5-Lightning
# Nemotron's thinking mode, on or off. Off was faster and wrote better rules in scripts/coach-bench.ts.
COACH_THINKING=off
