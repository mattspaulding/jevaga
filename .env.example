# Copy to .env.local and fill in. Never commit real keys.

# Vercel AI Gateway key (Strawberry Digital team → AI Gateway → API Keys). Used for Jev.
AI_GATEWAY_API_KEY=
# Nebius Token Factory key (Token Factory → API keys). Used for Nemotron lessons.
NEBIUS_API_KEY=

# jev (default) or fake for offline work. Fake play is labeled SIMULATED.
SYSTEM1=jev
JEV_MODEL=typesafe-ai/jev
LESSON_MODEL=nvidia/Nemotron-3_5-Lightning
